# Copy to .env for local runs (never commit .env). On Railway, set these as service variables.

# --- Stripe (dashboard > Developers) ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint https://<your-host>/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Must match the API version the Stripe mobile SDK in the apps speaks (see the SDK release notes).
STRIPE_EPHEMERAL_KEY_API_VERSION=2025-06-30.basil

# --- Clerk (dashboard > API keys > Frontend API URL; the same CLERK_ISSUER the Pulse API gateway uses) ---------
CLERK_ISSUER=https://<your-frontend-api>
# Optional: only if the keys are not at <issuer>/.well-known/jwks.json
# CLERK_JWKS_URL=
# Only needed for tokens that carry an `azp` claim (browsers). Native app tokens have none.
CLERK_AUTHORIZED_PARTIES=

# --- Database ---------------------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to false when migrations are applied by another tool.
BILLING_RUN_MIGRATIONS=true

# --- Behaviour --------------------------------------------------------------------------------------
BILLING_ENABLED=true
BILLING_MERCHANT_NAME=Pulse
BILLING_PLANS=premium_monthly,premium_yearly
BILLING_TRIAL_DAYS=0
# Where a purchase may be started. `*` = everywhere. Read billing/docs/store-policy.md before changing these.
BILLING_PURCHASE_COUNTRIES_IOS=US
BILLING_PURCHASE_COUNTRIES_ANDROID=US
BILLING_AUTOMATIC_TAX=false
BILLING_PAST_DUE_GRACE_DAYS=3
# Prefixes (end with / or ://) or exact URLs the apps may pass as the portal returnUrl.
BILLING_PORTAL_RETURN_URLS=pulse://
PORT=3000
