<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (android:fullBackupContent): nothing of the watch app is backed up. What it stores is a copy of the snapshot the
     phone pushed and a few choices that are cheap to make again; the phone sends the snapshot again. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
