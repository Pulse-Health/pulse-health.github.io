    <string name="widget_weekly_goal_compact_label">Weekly goal gauge</string>
    <string name="widget_weekly_goal_compact_description">A compact gauge of the workouts you finished this week against your goal.</string>
    <string name="widget_days_since_label">Days since training</string>
    <string name="widget_days_since_description">How many days have passed since your last workout.</string>
    <string name="widget_streak_label">Week streak</string>
    <string name="widget_streak_description">The number of weeks in a row that you met your workout goal.</string>
    <string name="widget_quick_start_label">Quick start</string>
    <string name="widget_quick_start_description">One tap starts your next workout, or opens the one that is running.</string>
    <string name="widget_next_up_compact_label">Next workout</string>
    <string name="widget_next_up_compact_description">Your next workout, its exercises and how long it takes.</string>
