    <string name="widget_loaded_bar_description">The plates to load on each side for today\'s top set.</string>
    <string name="widget_rest_day_label">Rest-day swap</string>
    <string name="widget_rest_day_description">A short recovery routine on rest days, your next workout otherwise.</string>
    <string name="widget_strength_ratio_label">Strength ratio</string>
    <string name="widget_strength_ratio_description">Your estimated one-rep max on a main lift against your bodyweight.</string>
    <string name="widget_year_in_iron_label">Year in iron</string>
    <string name="widget_year_in_iron_description">The tonnes you lifted this year, month by month.</string>
    <string name="widget_readiness_label">Readiness</string>
    <string name="widget_readiness_description">Today\'s readiness from Pulse, to decide how hard to push.</string>
    <string name="widget_plateau_label">Plateau watch</string>
    <string name="widget_plateau_description">Lifts that have stalled, with one way to move them.</string>
    <string name="widget_session_timeline_label">Session timeline</string>
    <string name="widget_session_timeline_description">How the time of your last workout was split between lifting and rest.</string>
