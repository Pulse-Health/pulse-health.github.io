    <string name="widget_weekly_sets_compact_description">Sets finished this week against the target, and the muscle group that lags.</string>
    <string name="widget_pr_compact_label">Latest record</string>
    <string name="widget_pr_compact_description">Your newest personal record with its estimated one-rep max.</string>
    <string name="widget_overload_compact_label">Overload target</string>
    <string name="widget_overload_compact_description">What to lift today to beat last time.</string>
    <string name="widget_inline_week_label">Weekly goal line</string>
    <string name="widget_inline_week_description">One line: how many workouts you finished this week.</string>
    <string name="widget_inline_split_label">Split line</string>
    <string name="widget_inline_split_description">One line: your next split and how long ago you last trained it.</string>
