    <string name="widget_body_map_label">Body map</string>
    <string name="widget_body_map_description">Front and back silhouettes shaded by the sets each muscle group got this week.</string>
    <string name="widget_log_set_label">Log a set</string>
    <string name="widget_log_set_description">Adjust the next set, log it and control the rest timer without opening the app.</string>
    <string name="widget_partner_label">Gym partner</string>
    <string name="widget_partner_description">Your week next to your training partners\' weeks.</string>
    <string name="widget_form_cue_label">Form cue</string>
    <string name="widget_form_cue_description">One coaching cue for the first lift of your next workout.</string>
