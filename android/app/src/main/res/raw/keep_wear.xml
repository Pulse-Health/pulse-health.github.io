<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play services looks the capabilities of the phone app up by the name of this resource (res/values/wear.xml); no code of the
     app refers to it, so the resource shrinker of the release build would remove it and the watch could not find the phone by it. -->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities" />
