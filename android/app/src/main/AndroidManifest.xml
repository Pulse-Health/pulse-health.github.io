<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Each owner adds only inside its own marked region (see widgets/SPEC.md section 6). -->

    <!-- ==== permissions-host:begin ==== -->
    <!-- ==== permissions-host:end ==== -->

    <!-- ==== permissions-system:begin ==== -->
    <!-- ==== permissions-system:end ==== -->

    <!-- ==== permissions-wear:begin ==== -->
    <!-- ==== permissions-wear:end ==== -->

    <application
        android:name=".PulseApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- ==== host:begin (activities, deep links, application metadata) ==== -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- pulse-strength:// deep links of the widgets, tiles and notifications (widgets/SPEC.md section 4) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pulse-strength" />
            </intent-filter>
        </activity>
        <!-- ==== host:end ==== -->

        <!-- ==== glance-home:begin ==== -->
        <receiver
            android:name=".widgets.home.WeeklyGoalReceiver"
            android:exported="true"
            android:label="@string/widget_weekly_goal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_goal_widget_info" />
        </receiver>
        <!-- ==== glance-home:end ==== -->

        <!-- ==== glance-extras:begin ==== -->
        <!-- ==== glance-extras:end ==== -->

        <!-- ==== system:begin (service, receivers, tile services, shortcuts activity) ==== -->
        <!-- ==== system:end ==== -->

        <!-- ==== wear:begin (Data Layer listener service) ==== -->
        <!-- ==== wear:end ==== -->

    </application>
</manifest>
