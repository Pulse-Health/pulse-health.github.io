<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The ongoing workout notification and the rest alert (a runtime permission from Android 13). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets Android 16 show the workout notification as a "Live Update" chip; the user can switch it off. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Optional, user-enabled: save finished workouts to Health Connect. The app only writes, it never reads. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- Deliberately absent: INTERNET and ACCESS_NETWORK_STATE. The app is offline by design; a unit test guards this. -->
    <!-- WorkManager (a dependency of Glance, which draws the home screen widgets) declares ACCESS_NETWORK_STATE for network constraints
         the app never uses: take it out again so the merged manifest keeps its promise. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Each owner adds only inside its own marked region (see widgets/SPEC.md section 6). -->

    <!-- ==== permissions-host:begin ==== -->
    <!-- ==== permissions-host:end ==== -->

    <!-- ==== permissions-system:begin ==== -->
    <!-- A planned session (LA-06) lives in an alarm, and alarms do not survive a reboot: the plan is armed again when the phone starts.
         POST_NOTIFICATIONS and POST_PROMOTED_NOTIFICATIONS are declared above; no exact-alarm permission: the alarms here are inexact. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ==== permissions-system:end ==== -->

    <!-- ==== permissions-wear:begin ==== -->
    <!-- ==== permissions-wear:end ==== -->

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".PulseStrengthApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PulseStrength"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- pulse-strength://workout shows the running workout; the widgets, tiles and notifications use the other hosts of
                 widgets/SPEC.md section 4 (hub, start-next, start, start-empty, exercise, plates, weight). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pulse-strength" />
            </intent-filter>
            <!-- ==== host:begin (shortcuts meta-data and further intent filters of the main activity) ==== -->
            <!-- ==== host:end ==== -->
        </activity>

        <!-- ==== glance-home:begin ==== -->
        <receiver
            android:name=".widgets.home.WeeklyGoalReceiver"
            android:exported="true"
            android:label="@string/widget_weekly_goal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_goal_widget_info" />
        </receiver>
        <!-- ==== glance-home:end ==== -->

        <!-- ==== glance-extras:begin ==== -->
        <!-- ==== glance-extras:end ==== -->

        <!-- ==== system:begin (service, receivers, tile services, shortcuts activity) ==== -->
        <!--
            Launcher entry that carries the static shortcuts (CT-10). The integrator removes the LAUNCHER intent-filter from MainActivity,
            otherwise the app shows two launcher icons.
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- SB-02 / SB-04: full-screen bench mode, opened from the app, the widgets and the Rest tile (never from outside). -->
        <activity
            android:name=".live.BenchModeActivity"
            android:exported="false"
            android:label="@string/bench_mode_label"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PulseBench" />

        <!-- CT-10: starts from a launcher shortcut, Quick Tap, a side key or a routine; runs the primary action and finishes. -->
        <activity
            android:name=".controls.PrimaryActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_primary_short"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PulseTransparent" />

        <!-- Buttons that LiveUpdates adds to the workout notification (Log A2, the coach tip's answers). -->
        <receiver
            android:name=".live.WorkoutActionReceiver"
            android:exported="false" />

        <!-- The end of a PR flash (LA-01): the ongoing notification is drawn again without it. -->
        <receiver
            android:name=".live.LiveAlarmReceiver"
            android:exported="false" />

        <!-- LA-06: countdown, "Time to train", snooze, and arming the plan again after a reboot or an update. -->
        <receiver
            android:name=".live.PlannedSessionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- CT-01 ... CT-08: Quick Settings tiles. Active tiles: the app asks for a refresh through Controls.refresh. -->
        <service
            android:name=".controls.StartNextTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_start"
            android:label="@string/tile_start_next_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.LogSetTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_log"
            android:label="@string/tile_log_set_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.RestTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_rest"
            android:label="@string/tile_rest_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.AddRestTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add_rest"
            android:label="@string/tile_add_rest_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.PlatesTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_plates"
            android:label="@string/tile_plates_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pause"
            android:label="@string/tile_pause_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.FinishTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_finish"
            android:label="@string/tile_finish_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".controls.NextUpTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_next_up"
            android:label="@string/tile_next_up_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <!-- ==== system:end ==== -->

        <!-- ==== wear:begin (Data Layer listener service) ==== -->
        <!-- ==== wear:end ==== -->

        <!-- Health Connect: the screen that explains why the app writes workouts. -->
        <activity
            android:name=".health.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.PulseStrength">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+: the same screen as "How this app uses your data" in the system's health permission settings. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Buttons of the workout notification and the backup rest alarm. Not exported: only the app's own PendingIntents reach them. -->
        <receiver
            android:name=".services.NotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".services.RestAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
